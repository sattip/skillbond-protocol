flowchart TB
    A["Whistleblower<br/>discovers violation"] --> B{"Post counter-stake<br/>(50% of target's bond)"}
    B --> C["flagSkill(skillId, evidenceHash)<br/><i>evidence hash stored on-chain</i>"]
    C --> D{"Flag threshold<br/>met?"}

    D -->|"No"| E["Admin reviews<br/>evidence off-chain"]
    D -->|"Yes"| F["communitySlash(skillId)<br/><i>permissionless</i>"]

    E -->|"Valid"| G["executeSlash(skillId, whistleblower)"]
    E -->|"Invalid"| H["dismissFlag(skillId, flagger)"]

    G --> I["80% bounty → Whistleblower<br/>20% → Insurance Fund<br/>Counter-stake returned"]
    F --> I
    H --> J["Counter-stake → Insurance Fund<br/>Flag count decremented"]

    I --> K["Skill status → SLASHED<br/>All agents auto-reject"]
    J --> L["Skill remains ACTIVE"]

