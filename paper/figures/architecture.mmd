graph LR
    subgraph agent["AI Agent"]
        direction TB
        policy["Trust Policy Engine (SDK)<br/><i>minStake: 500, minTier: 2, minAge: 30d</i>"]
        cache["Local Cache<br/><i>event-synced, sub-ms reads</i>"]
        policy -->|"checkPolicy(skillId)"| cache
    end

    subgraph registry["SkillBond Registry (On-Chain)"]
        direction TB
        subgraph row1[" "]
            direction LR
            staking["Staking"]
            tiers["Trust Tiers<br/>(Age-gated)"]
            flagslash["Flag/Slash"]
        end
        subgraph row2[" "]
            direction LR
            fees["Usage Fees"]
            sponsor["Sponsorship"]
            pause["Emergency<br/>Pause"]
        end
    end

    cache -->|"cache miss → RPC fallback"| registry

    style agent fill:#f0f4f8,stroke:#4a7c59,stroke-width:2px,color:#1a1a1a
    style registry fill:#f7f7f7,stroke:#2d5a8e,stroke-width:2px,color:#1a1a1a
    style policy fill:#fff,stroke:#4a7c59,stroke-width:1px
    style cache fill:#fff,stroke:#4a7c59,stroke-width:1px
    style staking fill:#e8f0fe,stroke:#2d5a8e,stroke-width:1px
    style tiers fill:#e8f0fe,stroke:#2d5a8e,stroke-width:1px
    style flagslash fill:#e8f0fe,stroke:#2d5a8e,stroke-width:1px
    style fees fill:#e8f0fe,stroke:#2d5a8e,stroke-width:1px
    style sponsor fill:#e8f0fe,stroke:#2d5a8e,stroke-width:1px
    style pause fill:#e8f0fe,stroke:#2d5a8e,stroke-width:1px
    style row1 fill:none,stroke:none
    style row2 fill:none,stroke:none
